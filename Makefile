# ---------------------------------------------------------------------------
# Makefile: cross-compile ioquake3 for the Miyoo Mini (SigmaStar SSD202D,
# dual Cortex-A7, 128MB RAM) and package it with a button-binding config.
#
# Usage:
#   make toolchain-check   # verify cross compiler / sysroot
#   make                   # fetch source, build, package into dist/
#   make clean
#
# Override on the command line as needed, e.g.:
#   make CROSS=/opt/miyoomini-toolchain/bin/arm-linux-gnueabihf- \
#        SYSROOT=/opt/miyoomini-toolchain/arm-linux-gnueabihf/libc
# ---------------------------------------------------------------------------

# Uses ">" instead of TAB as the recipe prefix so copy/paste can't break it.
.RECIPEPREFIX := >

# ---- Toolchain (edit to match your install) -------------------------------
CROSS   ?= /opt/miyoomini-toolchain/bin/arm-linux-gnueabihf-
SYSROOT ?= /opt/miyoomini-toolchain/arm-linux-gnueabihf/libc
CC      := $(CROSS)gcc
CXX     := $(CROSS)g++
STRIP   := $(CROSS)strip

# ---- Source ---------------------------------------------------------------
IOQ3_REPO ?= https://github.com/ioquake/ioq3.git
IOQ3_REF  ?= main
SRC_DIR   ?= ioq3
DIST_DIR  ?= dist/ioquake3

# ---- Target CPU flags (Cortex-A7, NEON-VFPv4) -----------------------------
ARCH_FLAGS := -mcpu=cortex-a7 -mfpu=neon-vfpv4 -mfloat-abi=hard
OPT_FLAGS  := -O3 -ffast-math -fomit-frame-pointer -pipe

# ---- SDL (taken from the device sysroot) ----------------------------------
SDL_CONFIG ?= $(SYSROOT)/usr/bin/sdl2-config
SDL_CFLAGS := $(shell $(SDL_CONFIG) --cflags 2>/dev/null) --sysroot=$(SYSROOT)
SDL_LIBS   := $(shell $(SDL_CONFIG) --libs 2>/dev/null)

# ---- Flags handed to the upstream ioq3 Makefile ---------------------------
IOQ3_FLAGS := \
  ARCH=arm \
  CC="$(CC) --sysroot=$(SYSROOT)" \
  CXX="$(CXX) --sysroot=$(SYSROOT)" \
  OPTIMIZE="$(ARCH_FLAGS) $(OPT_FLAGS)" \
  SDL_CFLAGS="$(SDL_CFLAGS)" \
  SDL_LIBS="$(SDL_LIBS)" \
  BUILD_CLIENT=1 \
  BUILD_SERVER=0 \
  BUILD_GAME_SO=1 \
  BUILD_GAME_QVM=0 \
  BUILD_RENDERER_OPENGL2=0 \
  USE_RENDERER_DLOPEN=0 \
  USE_OPENAL=0 \
  USE_CURL=0 \
  USE_CODEC_VORBIS=0 \
  USE_CODEC_OPUS=0 \
  USE_VOIP=0 \
  USE_FREETYPE=0 \
  USE_INTERNAL_LIBS=1 \
  USE_LOCAL_HEADERS=1 \
  DEFAULT_BASEDIR=. \
  -j$(shell nproc)

# ---- Button bindings ------------------------------------------------------
# Miyoo Mini firmwares (stock / OnionOS SDL builds) present the buttons as
# keyboard keys. Common mapping assumed here:
#   D-Pad = arrow keys   A = L-Ctrl   B = L-Alt   X = L-Shift   Y = Space
#   L1 = E   R1 = T   L2 = Tab   R2 = Backspace   Start = Enter   Menu = Esc
# If your build differs, change the key names below.
define AUTOEXEC
// Generated by Makefile: Miyoo Mini controls
unbindall

// D-Pad: move
bind UPARROW    "+forward"
bind DOWNARROW  "+back"
bind LEFTARROW  "+moveleft"
bind RIGHTARROW "+moveright"

// Face buttons: look
bind CTRL  "+right"
bind ALT   "+lookdown"
bind SHIFT "+lookup"
bind SPACE "+left"

// Triggers / bumpers
bind BACKSPACE "+attack"
bind TAB       "+zoom"
bind e         "weapnext"
bind t         "weapprev"

// System
bind ENTER  "togglemenu"
bind ESCAPE "togglemenu"

// Keyboard-style turning/looking speed for a d-pad-only device
seta cl_yawspeed   "180"
seta cl_pitchspeed "140"
seta cl_run        "1"
seta in_nograb     "0"

// Low-res, low-load settings for the 128MB / no-GPU hardware
seta r_mode        "3"
seta r_fullscreen  "1"
seta r_picmip      "2"
seta r_vertexLight "1"
seta cg_drawGun    "1"
seta com_maxfps    "30"
seta s_initsound   "0"
endef
export AUTOEXEC

# ---- Targets --------------------------------------------------------------
.PHONY: all fetch build package toolchain-check clean distclean

all: package

toolchain-check:
> @test -x "$(CC)" || { echo "Cross compiler not found: $(CC)"; exit 1; }
> @test -d "$(SYSROOT)" || { echo "Sysroot not found: $(SYSROOT)"; exit 1; }
> @test -x "$(SDL_CONFIG)" || echo "Warning: $(SDL_CONFIG) missing; SDL flags will be empty."
> @echo "Toolchain OK: $$($(CC) -dumpmachine)"

fetch:
ifeq ($(SKIP_FETCH),1)
> @echo "SKIP_FETCH=1: using existing $(SRC_DIR)"
else
> @if [ ! -d "$(SRC_DIR)/.git" ]; then \
>   git clone $(IOQ3_REPO) $(SRC_DIR); \
> fi
> @cd $(SRC_DIR) && git fetch --quiet origin && git checkout --quiet $(IOQ3_REF)
endif

build: toolchain-check fetch
> $(MAKE) -C $(SRC_DIR) $(IOQ3_FLAGS)

package: build
> @mkdir -p $(DIST_DIR)/baseq3
> @cp $(SRC_DIR)/build/release-linux-arm/ioquake3.arm $(DIST_DIR)/ioquake3
> @cp $(SRC_DIR)/build/release-linux-arm/baseq3/*.so $(DIST_DIR)/baseq3/ 2>/dev/null || true
> @$(STRIP) $(DIST_DIR)/ioquake3 $(DIST_DIR)/baseq3/*.so 2>/dev/null || true
> @printf '%s\n' "$$AUTOEXEC" > $(DIST_DIR)/baseq3/autoexec.cfg
> @printf '%s\n' '#!/bin/sh' \
>   'cd "$$(dirname "$$0")"' \
>   'export HOME="$$PWD"' \
>   'export LD_LIBRARY_PATH="$$PWD/lib:/customer/lib:/config/lib:$$LD_LIBRARY_PATH"' \
>   'exec ./ioquake3 +set fs_basepath "$$PWD" +set fs_homepath "$$PWD"' \
>   > $(DIST_DIR)/launch.sh
> @chmod +x $(DIST_DIR)/launch.sh $(DIST_DIR)/ioquake3
> @echo ""
> @echo "Packaged in $(DIST_DIR)"
> @echo "Copy your own pak0.pk3 to $(DIST_DIR)/baseq3/ (not included)."

clean:
> -$(MAKE) -C $(SRC_DIR) clean
> rm -rf dist

distclean: clean
> rm -rf $(SRC_DIR)
